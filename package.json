{
  "name": "default-project",
  "version": "1.0.0",
  "description": "NIGHTFALL // NEON DISTRICT — a co-op open-world action and driving game for the browser.",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/game.js --log-level=warning",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=dist/game.js --sourcemap --watch --log-level=warning",
    "start": "node server.js",
    "serve": "node server.js",
    "test": "node --check server.js",
    "build:mobile": "npm run build && node tools/build-mobile.js",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noroblemo/nightfall-neon-district.git"
  },
  "keywords": [
    "game",
    "threejs",
    "multiplayer",
    "open-world"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/noroblemo/nightfall-neon-district/issues"
  },
  "homepage": "https://noroblemo.github.io/nightfall-neon-district/",
  "dependencies": {
    "peerjs": "^1.5.5",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "esbuild": "^0.28.2"
  }
}
